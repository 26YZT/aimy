{
  "name": "@proj-airi/core-agent",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "description": "Core agent runtime orchestration for AIRI",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/airi.git",
    "directory": "packages/core-agent"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./agents/spark-notify": {
      "types": "./dist/agents/spark-notify/index.d.mts",
      "default": "./dist/agents/spark-notify/index.mjs"
    },
    "./agents/spark-command": {
      "types": "./dist/agents/spark-command/index.d.mts",
      "default": "./dist/agents/spark-command/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "eval:run": "vieval run --config ./vieval.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/std": "0.1.0-beta.17",
    "@proj-airi/pipelines-audio": "workspace:^",
    "@proj-airi/plugin-protocol": "workspace:^",
    "@proj-airi/provider-inference": "workspace:^",
    "@proj-airi/server-sdk": "workspace:^",
    "@proj-airi/server-shared": "workspace:^",
    "@proj-airi/stream-kit": "workspace:^",
    "@xsai-ext/providers": "0.5.0",
    "@xsai-ext/responses": "0.5.0",
    "@xsai/generate-speech": "0.5.0",
    "@xsai/generate-text": "0.5.0",
    "@xsai/model": "0.5.0",
    "@xsai/shared": "0.5.0",
    "@xsai/shared-chat": "0.5.0",
    "@xsai/stream-text": "0.5.0",
    "@xsai/tool": "0.5.0",
    "nanoid": "^6.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vieval": "^0.0.12",
    "xsschema": "0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/unist": "^3.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
