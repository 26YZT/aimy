# 只在本机填写自己的服务配置，不要提交真实 .env。
AIMY_API_KEY=
AIMY_MODEL=
# OpenAI-compatible 服务可配置自己的 /v1 地址；空值采用 AIRI OpenAI provider。
AIMY_BASE_URL=
AIMY_API=chat-completions
# 可选：AIMY_ENV_FILE 用来覆盖默认工作区根目录配置文件。

# B 服务探测：分别填写已有服务，默认不发请求。仅显式 --live 使用。
AIMY_VISION_API_KEY=
AIMY_VISION_MODEL=
AIMY_VISION_BASE_URL=
AIMY_VISION_API=chat-completions
AIMY_ASR_API_KEY=
AIMY_ASR_MODEL=
AIMY_ASR_BASE_URL=
AIMY_TTS_API_KEY=
AIMY_TTS_MODEL=
AIMY_TTS_BASE_URL=
AIMY_TTS_VOICE=
